# Run: python3 scripts/bootstrap.py (generates real random passwords in .env).
# Never commit .env. The default port avoids an existing MySQL on 3306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=olist
MYSQL_USER=olist_loader
MYSQL_PASSWORD=GENERATE_WITH_BOOTSTRAP
MYSQL_ROOT_PASSWORD=GENERATE_WITH_BOOTSTRAP
MYSQL_ANALYST_USER=olist_analyst
MYSQL_ANALYST_PASSWORD=GENERATE_WITH_BOOTSTRAP
# Existing remote server only: verify its certificate and hostname.
MYSQL_SSL_CA=

